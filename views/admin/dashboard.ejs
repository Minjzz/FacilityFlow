<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="icon" type="image/png" href="../../images/logo/e.png">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
        integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <nav class="site-nav">
        <button class="sidebar-toggle">
            <i class="fa-solid fa-bars"></i>
        </button>
    </nav>
    <div class="container">
        <aside class="sidebar">
            <header class="sidebar-header">
                <img src="/images/logaur.png" alt="Logo" class="header-logo">
                <h1 class="header-title">
                    FacilityFlow
                </h1>
                <button class="sidebar-toggle">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </header>

            <div class="sidebar-content">
                <ul class="menu-list">
                    <li class="menu-item">
                        <a href="/admin/dashboard" class="menu-link active">
                            <span class="material-symbols-rounded">dashboard</span>
                            <span class="link-label">Dashboard</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/facility_mgnt" class="menu-link">
                            <span class="material-symbols-rounded">domain</span>
                            <span class="menu-label">Facility Management</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/reservations" class="menu-link">
                            <span class="material-symbols-rounded">event</span>
                            <span class="menu-label">Reservation Requests</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/stud_records" class="menu-link">
                            <span class="material-symbols-rounded">group</span>
                            <span class="menu-label">Student Records</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/analytics" class="menu-link">
                            <span class="material-symbols-rounded">bar_chart</span>
                            <span class="menu-label">Usage Analytics</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/feedbacks" class="menu-link">
                            <span class="material-symbols-rounded">feedback</span>
                            <span class="menu-label">Feedback Reports</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/settings" class="menu-link">
                            <span class="material-symbols-rounded">settings</span>
                            <span class="menu-label">Account Settings</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="main-content">

            <div class="dashboard-navbar">
                <!-- <button class="theme-toggle">
                    <span class="theme-icon material-symbols-rounded">dark_mode</span>
                </button> -->
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b>
                                <%= user.name %>
                            </b></p>
                        <small class="text-muted">
                            <%= user.role %>
                        </small>
                    </div>

                    <div class="profile-photo" onclick="toggleDropdown()">
                        <img src="../../images/profile/profile.png" alt="Profile Photo">
                    </div>
                </div>

                <div class="dropdown-menu" id="dropdownMenu">
                    <a href="#"><span class="theme-icon material-symbols-rounded">person</span> Profile</a>
                    <a href="#"><span class="theme-icon material-symbols-rounded">settings</span> Settings</a>
                    <a href="/logout"><span class="theme-icon material-symbols-rounded">logout</span>
                        Logout</a>
                </div>
            </div>

            <div class="page-header">
                <h1 class="page-title">Dashboard</h1>
            </div>

            <div class="insights">
                <div class="insight-card" style="border-left: 5px solid #27ae60;">
                    <span class="material-symbols-rounded insight-icon" style="color: #27ae60;">dashboard</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Total Facilities</h3>
                        <p class="insight-value">12</p>
                    </div>
                </div>

                <div class="insight-card" style="border-left: 5px solid #2980b9;">
                    <span class="material-symbols-rounded insight-icon" style="color: #2980b9;">event_available</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Today's Reservations</h3>
                        <p class="insight-value">34</p>
                    </div>
                </div>

                <div class="insight-card" style="border-left: 5px solid #f39c12;">
                    <span class="material-symbols-rounded insight-icon" style="color: #f39c12;">groups</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Registered Students</h3>
                        <p class="insight-value">256</p>
                    </div>
                </div>

                <div class="insight-card" style="border-left: 5px solid #e74c3c;">
                    <span class="material-symbols-rounded insight-icon" style="color: #e74c3c;">feedback</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Feedback Reports</h3>
                        <p class="insight-value">18</p>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid">
                <div class="left-panel">
                    <h2>Recent Reservations</h2>
                    <div class="recent_order">
                        <table id="dashboardTable">
                            <thead>
                                <tr>
                                    <th>Reservation ID</th>
                                    <th>Student Name</th>
                                    <th>Facility</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#R101</td>
                                    <td>Juan Dela Cruz</td>
                                    <td>Library</td>
                                    <td>2025-10-23</td>
                                    <td><span class="status approved">Approved</span></td>
                                </tr>
                                <tr>
                                    <td>#R102</td>
                                    <td>Maria Santos</td>
                                    <td>Computer Lab</td>
                                    <td>2025-10-23</td>
                                    <td><span class="status pending">Pending</span></td>
                                </tr>
                                <tr>
                                    <td>#R103</td>
                                    <td>Jose Ramirez</td>
                                    <td>Study Room</td>
                                    <td>2025-10-22</td>
                                    <td><span class="status approved">Approved</span></td>
                                </tr>
                                <tr>
                                    <td>#R104</td>
                                    <td>Anna Cruz</td>
                                    <td>Library</td>
                                    <td>2025-10-21</td>
                                    <td><span class="status cancelled">Cancelled</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="line-chart-card">
                        <h3>Daily Reservations Trend</h3>
                        <canvas id="lineChart"></canvas>
                    </div>
                </div>

                <div class="right-side">
                    <div class="chart-analysis-card">
                        <h3>Facility Usage Overview</h3>
                        <div class="charts-container">
                            <div class="chart-wrapper">
                                <canvas id="pieChart"></canvas>
                                <p class="chart-label">Reservations by Facility</p>
                            </div>
                            <div class="chart-wrapper">
                                <canvas id="weeklyBarChart"></canvas>
                                <p class="chart-label">Reservations Over the Week</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script src="/js/dashboard.js"></script>

</body>

</html>