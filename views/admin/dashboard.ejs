<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FacilityFlow Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-light">

<div class="d-flex">

  <!-- Sidebar -->
  <nav class="sidebar bg-success text-white d-flex flex-column p-3">
    <h3 class="fw-bold mb-4 text-center">FacilityFlow</h3>
    <ul class="nav nav-pills flex-column mb-auto">
      <li class="nav-item"><a href="#" class="nav-link text-white"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
      <li><a href="#" class="nav-link text-white"><i class="bi bi-building me-2"></i> Facilities</a></li>
      <li><a href="#" class="nav-link text-white"><i class="bi bi-people me-2"></i> Users</a></li>
      <li><a href="#" class="nav-link text-white"><i class="bi bi-bar-chart-line me-2"></i> Analytics</a></li>
      <li><a href="#" class="nav-link text-white"><i class="bi bi-gear me-2"></i> Settings</a></li>
    </ul>
  </nav>

  <!-- Main Content -->
  <div class="flex-grow-1 p-4">

    <!-- Top Navbar / Profile Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold text-success">Dashboard</h2>
        <p class="text-muted mb-0">Overview of campus resources</p>
      </div>
      <div class="d-flex align-items-center">
        <span class="me-2 text-success fw-medium">Admin User</span>
        <img src="https://via.placeholder.com/40" alt="Profile" class="rounded-circle border border-success" />
      </div>
    </div>

    <!-- Two Main Cards -->
    <div class="row g-4 mb-4">
      <div class="col-12 col-md-6">
        <div class="card stat-card">
          <div class="card-body">
            <h6 class="card-title mb-2">Total Users</h6>
            <h3 class="fw-bold">2,847</h3>
            <small class="text-success">+12.5% from last month</small>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="card stat-card">
          <div class="card-body">
            <h6 class="card-title mb-2">Active Facilities</h6>
            <h3 class="fw-bold">124</h3>
            <small class="text-success">+4.3% from last month</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Graphs and Chart -->
    <div class="row g-4">
      <!-- Graph 1: Resource Utilization (Line Chart) -->
      <div class="col-12 col-lg-6">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-1">Resource Utilization</h5>
            <small class="text-muted">Daily usage per facility</small>
          </div>
          <div class="card-body">
            <canvas id="resourceGraph"></canvas>
          </div>
        </div>
      </div>

      <!-- Graph 2: User Activity (Bar Chart) -->
      <div class="col-12 col-lg-6">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-1">User Activity</h5>
            <small class="text-muted">Logins per day</small>
          </div>
          <div class="card-body">
            <canvas id="userGraph"></canvas>
          </div>
        </div>
      </div>

      <!-- Chart: Efficiency Score (Doughnut) -->
      <div class="col-12 col-lg-4">
        <div class="card">
          <div class="card-header">
            <h5 class="mb-1">Efficiency Score</h5>
            <small class="text-muted">Overall rating</small>
          </div>
          <div class="card-body d-flex justify-content-center align-items-center">
            <canvas id="efficiencyChart" height="250"></canvas>
          </div>
        </div>
      </div>
    </div>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/dashboard.js"></script>
</body>
</html>
