<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings | FacilityFlow</title>
    <link rel="icon" type="image/png" href="../../images/logo/e.png">
    <link rel="stylesheet" href="/css/admin/settings.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
</head>

<body>
    <nav class="site-nav">
        <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
    </nav>

    <div class="container">
        <aside class="sidebar">
            <header class="sidebar-header">
                <img src="/images/facilitylogo.png" alt="Logo" class="header-logo">
                <h1 class="header-title">iFacility</h1>
                <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
            </header>

            <div class="sidebar-content">
                <ul class="menu-list">
                    <li><a href="/admin/dashboard" class="menu-link"><span
                                class="material-symbols-rounded">dashboard</span>
                            <span class="menu-label">Dashboard</span>
                        </a>
                    </li>
                    <li><a href="/admin/facility_mgnt" class="menu-link"><span
                                class="material-symbols-rounded">domain</span>
                            <span class="menu-label">Facility Management</span>
                        </a>
                    </li>
                    <li><a href="/admin/reservations" class="menu-link"><span
                                class="material-symbols-rounded">event</span>
                            <span class="menu-label">Reservation Requests</span>
                        </a>
                    </li>
                    <li><a href="/admin/stud_records" class="menu-link"><span
                                class="material-symbols-rounded">group</span>
                            <span class="menu-label">Student Records</span>
                        </a>
                    </li>
                    <li><a href="/admin/analytics" class="menu-link"><span
                                class="material-symbols-rounded">bar_chart</span>
                            <span class="menu-label">Usage Analytics</span>
                        </a>
                    </li>
                    <li><a href="/admin/feedbacks" class="menu-link"><span
                                class="material-symbols-rounded">feedback</span>
                            <span class="menu-label">Feedback Reports</span>
                        </a>
                    </li>
                    <li><a href="/admin/settings" class="menu-link active"><span
                                class="material-symbols-rounded">settings</span>
                            <span class="menu-label">Account Settings</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="main-content">
            <div class="dashboard-navbar">
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b><%= user.name %></b></p>
                        <small class="text-muted">Admin</small>
                    </div>
                    <div class="profile-photo" onclick="toggleDropdown()">
                        <img src="../../images/profile/profile.png" alt="Profile Photo">
                    </div>
                </div>

                <div class="dropdown-menu" id="dropdownMenu">
                    <a href="#"><span class="material-symbols-rounded">person</span> Profile</a>
                    <a href="#"><span class="material-symbols-rounded">settings</span> Settings</a>
                    <a href="../../backend/logout.php"><span class="material-symbols-rounded">logout</span> Logout</a>
                </div>
            </div>

            <div class="page-header">
                <h1 class="page-title">Account Settings</h1>
                <p class="page-subtitle">Manage your account information, password, and preferences.</p>
            </div>

            <div class="settings-container">
                <div class="settings-row">
                    <section class="settings-section">
                        <h2>Profile Information</h2>
                        <form class="settings-form" id="profileForm" action="/admin/updateProfile" method="POST">
                            <div class="form-group">
                                <label>Full Name</label>
                                <input type="text" name="name" value="<%= user.name %>">
                            </div>
                            <div class="form-group">
                                <label>Email Address</label>
                                <input type="email" name="email" value="<%= user.email %>">
                            </div>
                            <button type="submit" class="save-btn">Save Changes</button>
                        </form>
                    </section>

                    <section class="settings-section">
                        <h2>Change Password</h2>
                        <form class="settings-form" id="passwordForm" action="/admin/changePassword" method="POST">
                            <div class="form-group">
                                <label>Current Password</label>
                                <input type="password" name="currentPassword" placeholder="Enter current password">
                            </div>
                            <div class="form-group">
                                <label>New Password</label>
                                <input type="password" name="newPassword" placeholder="Enter new password">
                            </div>
                            <div class="form-group">
                                <label>Confirm New Password</label>
                                <input type="password" name="confirmPassword" placeholder="Re-enter new password">
                            </div>
                            <button type="submit" class="save-btn">Update Password</button>
                        </form>
                    </section>

                </div>

                <div class="settings-row">
                    <section class="settings-section">
                        <h2>Account Security</h2>
                        <form class="settings-form">
                            <div class="form-group">
                                <label>Two-Factor Authentication</label>
                                <input type="text" placeholder="Enable or manage 2FA">
                            </div>
                            <div class="form-group">
                                <label>Last Login</label>
                                <input type="text" value="Oct 22, 2025 - 09:45 PM" readonly>
                            </div>
                            <button type="submit" class="save-btn">Update Security</button>
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <% if (alert) { %>
        <script>
            Swal.fire({
                icon: '<%= alert.type %>',
                title: '<%= alert.title %>',
                text: '<%= alert.message %>',
                timer: 1500,
                showConfirmButton: false
            });
        </script>
        <% } %>
        </script>
</body>

</html>