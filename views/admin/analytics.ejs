<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usage Analytics | FacilityFlow</title>
    <link rel="icon" type="image/png" href="../../images/logo/e.png">
    <link rel="stylesheet" href="/css/admin/analytics.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <nav class="site-nav">
        <button class="sidebar-toggle">
            <i class="fa-solid fa-bars"></i>
        </button>
    </nav>

    <div class="container">
        <aside class="sidebar">
            <header class="sidebar-header">
                <img src="/images/logaur.png" alt="Logo" class="header-logo">
                <h1 class="header-title">FacilityFlow</h1>
                <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
            </header>

            <div class="sidebar-content">
                <ul class="menu-list">
                    <li><a href="/admin/dashboard" class="menu-link"><span
                                class="material-symbols-rounded">dashboard</span><span
                                class="menu-label">Dashboard</span></a></li>
                    <li><a href="/admin/facility_mgnt" class="menu-link"><span
                                class="material-symbols-rounded">domain</span><span class="menu-label">Facility
                                Management</span></a></li>
                    <li><a href="/admin/reservations" class="menu-link"><span
                                class="material-symbols-rounded">event</span><span class="menu-label">Reservation
                                Requests</span></a></li>
                    <li><a href="/admin/stud_records" class="menu-link"><span
                                class="material-symbols-rounded">group</span><span class="menu-label">Student
                                Records</span></a></li>
                    <li><a href="/admin/analytics" class="menu-link active"><span
                                class="material-symbols-rounded">bar_chart</span><span class="menu-label">Usage
                                Analytics</span></a></li>
                    <li><a href="/admin/feedbacks" class="menu-link"><span
                                class="material-symbols-rounded">feedback</span><span class="menu-label">Feedback
                                Reports</span></a></li>
                    <li><a href="/admin/settings" class="menu-link"><span
                                class="material-symbols-rounded">settings</span><span class="menu-label">Account
                                Settings</span></a></li>
                </ul>
            </div>
        </aside>

        <div class="main-content">
            <div class="page-header">
                <h1 class="page-title">Usage Analytics</h1>
                <p class="page-subtitle">Overview of facility reservations and trends for better management.</p>
            </div>

            <div class="insights">
                <div class="insight-card">
                    <span class="material-symbols-rounded insight-icon">groups</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Active Users</h3>
                        <p class="insight-value"><%= analyticsData.activeUsers %></p>
                    </div>
                </div>
                <div class="insight-card">
                    <span class="material-symbols-rounded insight-icon">event</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Bookings This Week</h3>
                        <p class="insight-value"><%= analyticsData.bookingsThisWeek %></p>
                    </div>
                </div>
                <div class="insight-card">
                    <span class="material-symbols-rounded insight-icon">schedule</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Average Usage Time</h3>
                        <p class="insight-value"><%= analyticsData.avgUsageTime %> hrs</p>
                    </div>
                </div>
                <div class="insight-card">
                    <span class="material-symbols-rounded insight-icon">trending_up</span>
                    <div class="insight-details">
                        <h3 class="insight-title">Usage Growth</h3>
                        <p class="insight-value">+<%= analyticsData.usageGrowth %>%</p>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid">
                <div class="left-panel">
                    <div class="chart-card">
                        <h3>Facility Usage (Monthly)</h3>
                        <canvas id="usageChart"></canvas>
                    </div>

                </div>

                <div class="right-side">
                    <div class="chart-card">
                        <h3>Peak Usage by Hour</h3>
                        <canvas id="hourlyChart"></canvas>
                    </div>

                    <div class="chart-card">
                        <h3>Top 5 Most Used Facilities</h3>
                        <canvas id="topFacilitiesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const analyticsData = JSON.parse('<%- JSON.stringify(analyticsData).replace(/'/g, "\\'") %>');
        
        const ctxUsage = document.getElementById('usageChart').getContext('2d');
        new Chart(ctxUsage, {
            type: 'line',
            data: {
                labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
                datasets: [{
                    label: 'Reservations',
                    data: analyticsData.monthlyUsage,
                    borderColor: '#27ae60',
                    backgroundColor: 'rgba(39, 174, 96, 0.2)',
                    fill: true,
                    tension: 0.4
                }]
            }
        });

        const ctxTop = document.getElementById('topFacilitiesChart').getContext('2d');
        new Chart(ctxTop, {
            type: 'bar',
            data: {
                labels: analyticsData.topFacilities.map(f => f.name),
                datasets: [{
                    label: 'Reservations',
                    data: analyticsData.topFacilities.map(f => f.count),
                    backgroundColor: '#2980b9'
                }]
            },
            options: { plugins: { legend: { display: false } } }
        });

        const ctxHour = document.getElementById('hourlyChart').getContext('2d');
        new Chart(ctxHour, {
            type: 'bar',
            data: {
                labels: Array.from({length: 24}, (_, i) => (i < 12 ? i + 'AM' : (i-12 || 12) + 'PM')),
                datasets: [{
                    label: 'Usage Count',
                    data: analyticsData.hourlyUsage,
                    backgroundColor: '#e74c3c'
                }]
            }
        });
    </script>
    
</body>
</html>
