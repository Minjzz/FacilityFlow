<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Records | FacilityFlow</title>
    <link rel="icon" type="image/png" href="../../images/logo/e.png" />
    <link rel="stylesheet" href="/css/admin/stud_records.css" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
</head>

<body>
    <nav class="site-nav">
        <button class="sidebar-toggle">
            <i class="fa-solid fa-bars"></i>
        </button>
    </nav>

    <div class="container">
        <aside class="sidebar">
            <header class="sidebar-header">
                <img src="/images/facilitylogo.png" alt="Logo" class="header-logo" />
                <h1 class="header-title">iFacility</h1>
                <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
            </header>

            <div class="sidebar-content">
                <ul class="menu-list">
                    <li class="menu-item">
                        <a href="/admin/dashboard" class="menu-link">
                            <span class="material-symbols-rounded">dashboard</span>
                            <span class="menu-label">Dashboard</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/facility_mgnt" class="menu-link">
                            <span class="material-symbols-rounded">domain</span>
                            <span class="menu-label">Facility Management</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/reservations" class="menu-link">
                            <span class="material-symbols-rounded">event</span>
                            <span class="menu-label">Reservation Requests</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/stud_records" class="menu-link active">
                            <span class="material-symbols-rounded">group</span>
                            <span class="menu-label">Student Records</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/analytics" class="menu-link">
                            <span class="material-symbols-rounded">bar_chart</span>
                            <span class="menu-label">Usage Analytics</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/feedbacks" class="menu-link">
                            <span class="material-symbols-rounded">feedback</span>
                            <span class="menu-label">Feedback Reports</span>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="/admin/settings" class="menu-link">
                            <span class="material-symbols-rounded">settings</span>
                            <span class="menu-label">Account Settings</span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="main-content">
            <div class="dashboard-navbar">
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b><%= user.name %></b></p>
                        <small class="text-muted">Admin</small>
                    </div>
                    <div class="profile-photo" onclick="toggleDropdown()">
                        <img src="../../images/profile/profile.png" alt="Profile Photo" />
                    </div>
                </div>

                <div class="dropdown-menu" id="dropdownMenu">
                    <a href="#"><span class="material-symbols-rounded">person</span> Profile</a>
                    <a href="#"><span class="material-symbols-rounded">settings</span> Settings</a>
                    <a href="../../backend/logout.php"><span class="material-symbols-rounded">logout</span> Logout</a>
                </div>
            </div>

            <div class="page-header">
                <h1 class="page-title">Student Records</h1>
                <p class="page-subtitle">Manage and track all registered students using the facility system.</p>
            </div>

            <div class="search-filter">
                <div class="search-bar">
                    <input type="text" placeholder="Search student name or ID..." />
                    <i class="fa fa-search"></i>
                </div>
                <div class="filter-dropdown">
                    <select>
                        <option>All Courses</option>
                        <option>BSIT</option>
                        <option>BSCS</option>
                        <option>BSHM</option>
                        <option>BSA</option>
                    </select>
                </div>
                <div class="add-student-container" style="margin-bottom: 1.5rem;">
                    <button id="addStudentBtn" class="add-btn">
                        <i class="fa-solid fa-user-plus"></i> Add New Student
                    </button>
                </div>
            </div>

            <div id="addStudentModal" class="modal" aria-hidden="true">
                <div class="modal-content">
                    <span class="close" role="button" aria-label="Close">&times;</span>
                    <h2>Add New Student</h2>
                    <form id="addStudentForm" action="/addStudent" method="POST">
                        <div class="form-group">
                            <label for="studentId">Student ID</label>
                            <input type="text" id="studentId" name="id_num" placeholder="2025-023414" required>
                        </div>
                        <div class="form-group">
                            <label for="fullName">Full Name</label>
                            <input type="text" id="fullName" name="name" placeholder="Jane Doe" required>
                        </div>
                        <div class="form-group">
                            <label for="year">Year Level</label>
                            <select id="year" name="year" required>
                                <option value="">Select Year</option>
                                <option>1st Year</option>
                                <option>2nd Year</option>
                                <option>3rd Year</option>
                                <option>4th Year</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="text" id="fullName" name="email" placeholder="you@phinmaed.com" required>
                        </div>
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" placeholder="" required>
                        </div>
                        <div class="form-group">
                            <label for="status">Status</label>
                            <select id="status" name="status" required>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                        <button type="submit" class="save-btn">Save Student</button>
                    </form>
                </div>
            </div>

            <div class="student-table">
                <table>
                    <thead>
                        <tr>
                            <th>ID Number</th>
                            <th>Full Name</th>
                            <th>Year Level</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(results=> { %>
                            <tr>
                                <td>
                                    <%= results.id_num %>
                                </td>
                                <td>
                                    <%= results.name %>
                                </td>
                                <td>
                                    <%= results.year %>
                                </td>
                                <td>
                                    <span
                                        class="status <%= (results.status || '').toString().toLowerCase().replace(/\s+/g, '-') %>">
                                        <%= results.status %>
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="edit-btn"
                                            data-id="<%= results.id %>"
                                            data-id_num="<%= results.id_num %>"
                                            data-name="<%= results.name %>"
                                            data-year="<%= results.year %>"
                                            data-email="<%= results.email %>"
                                            data-status="<%= results.status %>">
                                            Edit
                                        </button>

                                        <form action="/deleteStudent/<%= results.id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="delete-btn">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                    <div id="updateStudentModal" class="modal">
                        <div class="modal-content">
                            <h2>Update Student</h2>
                            <span class="close">&times;</span>
                            <form id="updateStudentForm" action="/updateStudent" method="POST">
                                <input type="hidden" name="id" id="updateStudentId">

                                <div class="form-group">
                                    <label for="updateStudentNum">Student ID</label>
                                    <input type="text" name="id_num" id="updateStudentNum" required>
                                </div>

                                <div class="form-group">
                                    <label for="updateFullName">Full Name</label>
                                    <input type="text" name="name" id="updateFullName" required>
                                </div>

                                <div class="form-group">
                                    <label for="updateYear">Year Level</label>
                                    <select name="year" id="updateYear" required>
                                        <option>1st Year</option>
                                        <option>2nd Year</option>
                                        <option>3rd Year</option>
                                        <option>4th Year</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="updateEmail">Email</label>
                                    <input type="email" name="email" id="updateEmail" required>
                                </div>

                                <div class="form-group">
                                    <label for="updateStatus">Status</label>
                                    <select name="status" id="updateStatus" required>
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn-primary">Save Changes</button>
                                    <button type="button" class="btn-secondary close-modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </table>
            </div>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script src="/js/stud_records.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <% if (alert) { %>
        <script>
            Swal.fire({
                icon: '<%= alert.type %>',
                title: '<%= alert.title %>',
                text: '<%= alert.message %>',
                timer: 1500,
                showConfirmButton: false
            });
        </script>
        <% } %>
</body>

</html>