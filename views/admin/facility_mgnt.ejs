                                Settings</span></a></li>
                </ul>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <div class="dashboard-navbar">
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b>Marlon</b></p>
                        <small class="text-muted">Admin</small>
                    </div>
                    <div class="profile-photo" onclick="toggleDropdown()">
                        <img src="../../images/profile/profile.png" alt="Profile Photo">
                    </div>
                </div>

                <div class="dropdown-menu" id="dropdownMenu">
                    <a href="#"><span class="material-symbols-rounded">person</span> Profile</a>
                    <a href="#"><span class="material-symbols-rounded">settings</span> Settings</a>
                    <a href="../../backend/logout.php"><span class="material-symbols-rounded">logout</span> Logout</a>
                </div>
            </div>

            <div class="page-header">
                <h1 class="page-title">Facility Management</h1>
                <p class="page-subtitle">View, add, and manage all facilities in the system.</p>
            </div>

            <div class="controls">
                <select>
                    <option>All Types</option>
                    <option>Laboratory</option>
                    <option>Library</option>
                    <option>Study Room</option>
                </select>
                <button class="add-btn"><span class="material-symbols-rounded">add</span> Add Facility</button>
            </div>

            <div class="modal" id="addFacilityModal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>Add New Facility</h3>
                        <button class="close-modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <form id="addFacilityForm" action="/addFacility" method="POST" enctype="multipart/form-data">
                            <div class="form-group">
                                <label for="facilityName">Facility Name</label>
                                <input type="text" id="facilityName" name="name" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="facilityType">Facility Type</label>
                                <select id="type" name="type" required>
                                    <option value="">Select Type</option>
                                    <option>Laboratory</option>
                                    <option>Library</option>
                                    <option>Study Room</option>
                                    <option>Sports Facility</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="capacity">Capacity</label>
                                <input type="number" id="capacity" name="capacity" min="1" required>
                            </div>

                            <div class="form-group">
                                <label for="facilityImage">Facility Image</label>
                                <input type="file" id="facilityImage" name="image" accept="image/*" required>
                            </div>

                            <div class="form-group">
                                <label for="status">Status</label>
                                <select id="status" name="status" required>
                                    <option value="Available">Available</option>
                                    <option value="Unavailable">Unavailable</option>
                                </select>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn-secondary close-modal">Cancel</button>
                                <button type="submit" class="btn-primary">Add Facility</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- <div class="facility-grid" style="margin-top:1.5rem;">
                <div class="carousel-wrapper">
                    <button class="carousel-arrow left" aria-label="Previous">&lsaquo;</button>
                    <div class="carousel-track" id="facilityTrack" tabindex="0" role="list">
                        <% if (typeof facilities !== 'undefined' && facilities.length) { %>
                            <% facilities.forEach(f => { %>
                                <div class="facility-card" role="listitem">
                                    <img src="<%= f.image || '/images/placeholder.png' %>" class="facility-img" alt="<%= f.name %>" />
                                    <div class="facility-info">
                                        <h3><%= f.name %></h3>
                                        <p>Type: <%= f.type || '-' %></p>
                                        <p>Capacity: <%= f.capacity || '-' %></p>
                                        <span class="status <%= (f.status || '').toLowerCase() %>"><%= f.status %></span>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                    <button class="carousel-arrow right" aria-label="Next">&rsaquo;</button>
                </div>
            </div> -->

            <h2 style="margin-top: 2rem;">Facility Records</h2>
            <table class="facility-table">
                <thead>
                    <tr>
                        <th>Facility Name</th>
                        <th>Type</th>
                        <th>Capacity</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof facilities !== 'undefined' && facilities.length) { %>
                        <% facilities.forEach(f => { %>
                            <tr>
                                <td><%= f.name %></td>
                                <td><%= f.type || '-' %></td>
                                <td><%= f.capacity || '-' %></td>
                                <td><span class="status <%= (f.status || '').toLowerCase() %>"><%= f.status %></span></td>
                                <td><button class="edit-btn" data-id="<%= f.id %>">Edit</button></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5">No facility records found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script src="/js/facility_mgnt.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <% if (alert) { %>
        <script>
            Swal.fire({
                icon: '<%= alert.type %>',
                title: '<%= alert.title %>',
                text: '<%= alert.message %>',
                timer: 1500,
                showConfirmButton: false
            });
        </script>
    <% } %>
</body>

</html>