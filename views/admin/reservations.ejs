<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="icon" type="image/png" href="../../images/logo/e.png">
    <link rel="stylesheet" href="/css/admin/reservation.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
        integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <nav class="site-nav">
        <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
    </nav>

    <div class="container">
        <aside class="sidebar">
            <header class="sidebar-header">
                <img src="/images/logaur.png" alt="Logo" class="header-logo" />
                <h1 class="header-title">FacilityFlow</h1>
                <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
            </header>

            <div class="sidebar-content">
                <ul class="menu-list">
                    <li><a href="/admin/dashboard" class="menu-link"><span
                                class="material-symbols-rounded">dashboard</span> <span
                                class="menu-label">Dashboard</span></a></li>
                    <li><a href="/admin/facility_mgnt" class="menu-link"><span
                                class="material-symbols-rounded">domain</span> <span class="menu-label">Facility
                                Management</span></a></li>
                    <li><a href="/admin/reservations" class="menu-link active"><span
                                class="material-symbols-rounded">event</span> <span class="menu-label">Reservation
                                Requests</span></a></li>
                    <li><a href="/admin/stud_records" class="menu-link"><span
                                class="material-symbols-rounded">group</span> <span class="menu-label">Student
                                Records</span></a></li>
                    <li><a href="/admin/analytics" class="menu-link"><span
                                class="material-symbols-rounded">bar_chart</span> <span class="menu-label">Usage
                                Analytics</span></a></li>
                    <li><a href="/admin/feedbacks" class="menu-link"><span
                                class="material-symbols-rounded">feedback</span> <span class="menu-label">Feedback
                                Reports</span></a></li>
                    <li><a href="/admin/settings" class="menu-link"><span
                                class="material-symbols-rounded">settings</span> <span class="menu-label">Account
                                Settings</span></a></li>
                </ul>
            </div>
        </aside>

        <div class="main-content">
            <div class="dashboard-navbar">
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b>Marlon</b></p>
                        <small class="text-muted">Admin</small>
                    </div>
                    <div class="profile-photo" onclick="toggleDropdown()">
                        <img src="../../images/profile/profile.png" alt="Profile Photo" />
                    </div>
                </div>

                <div class="dropdown-menu" id="dropdownMenu">
                    <a href="#"><span class="material-symbols-rounded">person</span> Profile</a>
                    <a href="#"><span class="material-symbols-rounded">settings</span> Settings</a>
                    <a href="../../backend/logout.php"><span class="material-symbols-rounded">logout</span> Logout</a>
                </div>
            </div>

            <div class="page-header">
                <h1 class="page-title">Reservation Requests</h1>
                <p class="page-subtitle">View and manage all incoming reservation requests for each facility.</p>
            </div>

            <div class="search-filter">
                <div class="search-bar">
                    <input type="text" placeholder="Search reservations..." />
                    <i class="fa-solid fa-search"></i>
                </div>
                <div class="filter-dropdown">
                    <select>
                        <option value="">All Facilities</option>
                        <option value="lab">Labs</option>
                        <option value="library">Library</option>
                        <option value="study">Study Room</option>
                    </select>
                </div>
                <button class="add-btn" data-modal="newReservation"><i class="fa-solid fa-plus"></i> New Reservation</button>
            </div>

            <div class="modal" id="newReservationModal" aria-hidden="true">
                <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="newReservationTitle">
                    <div class="modal-header">
                        <h3 id="newReservationTitle">New Reservation Request</h3>
                        <button class="close-modal" aria-label="Close">&times;</button>
                    </div>
                    <div class="modal-body">
                        <form id="newReservationForm">
                            <div class="form-group">
                                <label for="studentName">Student Name</label>
                                <input type="text" id="studentName" name="studentName" required>
                            </div>

                            <div class="form-group">
                                <label for="reserveFacility">Facility</label>
                                <select id="reserveFacility" name="reserveFacility" required>
                                    <option value="">Select Facility</option>
                                    <option value="Library">Library</option>
                                    <option value="Computer Lab">Computer Lab</option>
                                    <option value="Study Room A">Study Room A</option>
                                    <option value="Campus Gym">Campus Gym</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="reserveDate">Date</label>
                                <input type="date" id="reserveDate" name="reserveDate" required>
                            </div>

                            <div class="form-group">
                                <label for="startTime">Start Time</label>
                                <input type="time" id="startTime" name="startTime" required>
                            </div>

                            <div class="form-group">
                                <label for="endTime">End Time</label>
                                <input type="time" id="endTime" name="endTime" required>
                            </div>

                            <div class="form-group">
                                <label for="attendees">Number of Attendees</label>
                                <input type="number" id="attendees" name="attendees" min="1" required>
                            </div>

                            <div class="form-group">
                                <label for="purpose">Purpose</label>
                                <input type="text" id="purpose" name="purpose" required>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn-secondary close-modal">Cancel</button>
                                <button type="submit" class="btn-primary">Submit Request</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="recent_order" style="margin-top: 2rem;">
                <table>
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Student Name</th>
                            <th>Facility</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% reservations.forEach(reservation => { %>
                        <tr>
                            <td><%= reservation.id %></td>
                            <td><%= reservation.student_name %></td>
                            <td><%= reservation.type %></td>
                            <td><%= reservation.date.toISOString().split('T')[0] %></td>
                            <td><%= reservation.time %></td>
                            <td>
                                <% if (reservation.status === 'Pending') { %>
                                    <span class="badge bg-warning text-dark"><%= reservation.status %></span>
                                <% } else if (reservation.status === 'Approved') { %>
                                    <span class="badge bg-success"><%= reservation.status %></span>
                                <% } else if (reservation.status === 'Rejected') { %>
                                    <span class="badge bg-danger"><%= reservation.status %></span>
                                <% } else if (reservation.status === 'Cancelled') { %>
                                    <span class="badge bg-secondary"><%= reservation.status %></span>
                                <% } %>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary">View</button>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script src="/js/reservations.js"></script>

</body>

</html>