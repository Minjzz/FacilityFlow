            <div class="page-header">
                <h1 class="page-title">Reservation Requests</h1>
                <p class="page-subtitle">View and manage all incoming reservation requests for each facility.</p>
            </div>

            <div class="search-filter">
                <div class="search-bar">
                    <input type="text" placeholder="Search reservations..." />
                    <i class="fa-solid fa-search"></i>
                </div>
                <div class="filter-dropdown">
                    <select>
                        <option value="">All Facilities</option>
                        <option value="lab">Labs</option>
                        <option value="library">Library</option>
                        <option value="study">Study Room</option>
                    </select>
                </div>
                <button class="add-btn"><i class="fa-solid fa-plus"></i> New Reservation</button>
            </div>

            <div class="recent_order" style="margin-top: 2rem;">
                <table>
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Student Name</th>
                            <th>Facility</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#R001</td>
                            <td>John Dela Cruz</td>
                            <td>Library</td>
                            <td>2025-10-22</td>
                            <td>1:00 PM - 3:00 PM</td>
                            <td><span class="status pending">Pending</span></td>
                            <td>
                                <button class="approve-btn"><i class="fa-solid fa-check"></i></button>
                                <button class="decline-btn"><i class="fa-solid fa-times"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td>#R002</td>
                            <td>Maria Santos</td>
                            <td>Computer Lab</td>
                            <td>2025-10-23</td>
                            <td>9:00 AM - 11:00 AM</td>
                            <td><span class="status approved">Approved</span></td>
                            <td>
                                <button class="approve-btn" disabled><i class="fa-solid fa-check"></i></button>
                                <button class="decline-btn"><i class="fa-solid fa-times"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
