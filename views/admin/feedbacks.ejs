<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feedback Reports | iFacility</title>
    <link rel="icon" type="image/png" href="../../images/logo/e.png">
    <link rel="stylesheet" href="/css/admin/feedbacks.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
    <style>

    </style>
</head>

<body>
    <nav class="site-nav">
        <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
    </nav>

    <div class="container">
        <aside class="sidebar">
            <header class="sidebar-header">
                <img src="/images/facilitylogo.png" alt="Logo" class="header-logo">
                <h1 class="header-title">iFacility</h1>
                <button class="sidebar-toggle"><i class="fa-solid fa-bars"></i></button>
            </header>

            <div class="sidebar-content">
                <ul class="menu-list">
                    <li><a href="/admin/dashboard" class="menu-link"><span class="material-symbols-rounded">dashboard</span><span
                                class="menu-label">Dashboard</span></a></li>
                    <li><a href="/admin/facility_mgnt" class="menu-link"><span class="material-symbols-rounded">domain</span><span
                                class="menu-label">Facility
                                Management</span></a></li>
                    <li><a href="/admin/reservations" class="menu-link"><span
                                class="material-symbols-rounded">event</span><span class="menu-label">Reservation
                                Requests</span></a></li>
                    <li><a href="/admin/stud_records" class="menu-link"><span
                                class="material-symbols-rounded">group</span><span class="menu-label">Student
                                Records</span></a></li>
                    <li><a href="/admin/analytics" class="menu-link"><span class="material-symbols-rounded">bar_chart</span><span
                                class="menu-label">Usage
                                Analytics</span></a></li>
                    <li><a href="/admin/feedbacks" class="menu-link active"><span
                                class="material-symbols-rounded">feedback</span><span class="menu-label">Feedback
                                Reports</span></a></li>
                    <li><a href="/admin/settings" class="menu-link"><span class="material-symbols-rounded">settings</span><span
                                class="menu-label">Account
                                Settings</span></a></li>
                </ul>
            </div>
        </aside>

        <div class="main-content">
            <div class="dashboard-navbar">
                <div class="profile">
                    <div class="info">
                        <p>Hey, <b><%= user.name %></b></p>
                        <small class="text-muted">Admin</small>
                    </div>
                    <div class="profile-photo" onclick="toggleDropdown()">
                        <img src="../../images/profile/profile.png" alt="Profile Photo">
                    </div>
                </div>

                <div class="dropdown-menu" id="dropdownMenu">
                    <a href="#"><span class="material-symbols-rounded">person</span> Profile</a>
                    <a href="#"><span class="material-symbols-rounded">settings</span> Settings</a>
                    <a href="../../backend/logout.php"><span class="material-symbols-rounded">logout</span> Logout</a>
                </div>
            </div>

            <div class="page-header">
                <h1 class="page-title">Feedback Reports</h1>
                <p class="page-subtitle">View, analyze, and manage student feedback about facility usage.</p>
            </div>

            <div class="feedback-grid">
                <div class="feedback-card">
                    <h3><i class="fa-solid fa-face-smile"></i> Positive Feedback</h3>
                    <p>
                        <%= stats.positiveCount %> positive feedback(s) received.
                    </p>
                    <small>Last updated: <%= new Date().toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                            year: 'numeric' }) %></small>
                </div>
            
                <div class="feedback-card">
                    <h3><i class="fa-solid fa-face-frown"></i> Negative Feedback</h3>
                    <p>
                        <%= stats.negativeCount %> negative feedback(s) reported.
                    </p>
                    <small>Last updated: <%= new Date().toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                            year: 'numeric' }) %></small>
                </div>
            
                <div class="feedback-card">
                    <h3><i class="fa-solid fa-lightbulb"></i> Suggestions</h3>
                    <p>
                        <%= stats.suggestionsCount %> suggestion(s) provided by students.
                    </p>
                    <small>Last updated: <%= new Date().toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                            year: 'numeric' }) %></small>
                </div>
            
                <div class="feedback-card">
                    <h3><i class="fa-solid fa-chart-line"></i> Insights</h3>
                    <p>Average rating: <%= stats.insights %>  ★</p>
                    <small>Last updated: <%= new Date().toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                            year: 'numeric' }) %></small>
                </div>
            </div>

            <div class="reports-table">
                <h2>All Feedback Reports</h2>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Rating</th>
                                <th>Service Quality</th>
                                <th>Facility Cleanliness</th>
                                <th>Comments</th>
                                <th>Suggestions</th>
                                <th>Date Submitted</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (feedbacks.length > 0) { %>
                                <% feedbacks.forEach((fb, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td><%= fb.student_name %></td>
                                        <td>
                                            <% for (let i = 0; i < fb.rating; i++) { %>
                                                ★
                                            <% } %>
                                        </td>
                                        <td><%= fb.service_quality || 'N/A' %></td>
                                        <td><%= fb.facility_cleanliness || 'General' %></td>
                                        <td><%= fb.comments %></td>
                                        <td><%= fb.suggestions %></td>
                                        <td><%= new Date(fb.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align:center;">No feedback found</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>

</html>