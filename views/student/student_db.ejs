<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FacilityFlow | Student Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/student/student_db.css" />
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/student/student_db">
                <img src="/images/facilitylogo.png" alt="FacilityFlow Logo">
                iFacility
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav d-flex align-items-center gap-3">
                    <li class="nav-item"><a class="nav-link" href="#dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="#booking">Book a Facility</a></li>
                    <li class="nav-item"><a class="nav-link" href="#reservations">My Reservations</a></li>
                    <li class="nav-item"><a class="nav-link" href="#feedback">Feedback</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container container-main my-5">
        <section id="profile" class="mb-5">
            <div
                class="card profile-card p-4 d-flex flex-md-row flex-column align-items-center justify-content-between shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-md-0 mb-3">
                    <div>
                        <h5 class="mb-0 fw-semibold">
                            <%= user.name %>
                        </h5>
                        <p class="text-muted mb-0">
                            <%= user.role %>, BS Information Technology
                        </p>
                    </div>
                </div>
                <button class="btn btn-logout" id="logoutBtn">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </div>
        </section>

        <section id="dashboard" class="mb-5">
            <h3 class="mb-4 fw-semibold">Facility Dashboard</h3>

            <div class="position-relative">
                <button class="scroll-btn scroll-left">&lt;</button>

                <div id="facility-container" class="d-flex overflow-auto px-2" style="gap: 1rem; scroll-behavior: smooth;">
                    <% 
                        const labs = facilities.filter(f => f.type === 'Laboratory');
                        const studyRooms = facilities.filter(f => f.type === 'Study Room');
                        const libraries = facilities.filter(f => f.type === 'Library');

                        const allCards = [...labs, ...studyRooms];

                        allCards.forEach(f => {
                            const percentage = f.capacity ? Math.min(100, Math.round((f.current_occupation / f.capacity) * 100)) : 0;
                            let statusColor = '', statusText = '';
                            if(percentage >= 90){ statusColor = '#d9534f'; statusText = 'Full'; }
                            else if(percentage >= 70){ statusColor = '#f0ad4e'; statusText = 'Almost Full'; }
                            else{ statusColor = '#5cb85c'; statusText = 'Available'; }
                    %>
                    <div class="card p-4 flex-shrink-0" style="width: 300px;">
                        <h5 class="fw-semibold mb-3"><%= f.name %></h5>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar" style="width: <%= percentage %>%; background-color: <%= statusColor %>;"></div>
                        </div>
                        <p>Status: <strong style="color: <%= statusColor %>;"><%= statusText %></strong></p>
                        <p>Capacity: <%= f.current_occupation %> / <%= f.capacity %></p>
                    </div>
                    <% }); %>

                    <% 
                        if(libraries.length){
                        let totalCapacity = 0, totalOccupation = 0;
                        libraries.forEach(f => { 
                            totalCapacity += f.capacity || 0; 
                            totalOccupation += f.current_occupation || 0; 
                        });
                        const percentage = totalCapacity ? Math.min(100, Math.round((totalOccupation / totalCapacity) * 100)) : 0;
                        let statusColor = '', statusText = '';
                        if(percentage >= 90){ statusColor = '#d9534f'; statusText = 'Full'; }
                        else if(percentage >= 70){ statusColor = '#f0ad4e'; statusText = 'Almost Full'; }
                        else{ statusColor = '#5cb85c'; statusText = 'Available'; }
                    %>
                    <div class="card p-4 flex-shrink-0" style="width: 300px;">
                        <h5 class="fw-semibold mb-3">Library</h5>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar" style="width: <%= percentage %>%; background-color: <%= statusColor %>;"></div>
                        </div>
                        <p>Status: <strong style="color: <%= statusColor %>;"><%= statusText %></strong></p>
                        <p>Capacity: <%= totalOccupation %> / <%= totalCapacity %></p>
                    </div>
                    <% } %>
                </div>

                <button class="scroll-btn scroll-right">&gt;</button>
            </div>
        </section>

        <section id="booking" class="mb-5">
            <div class="section-header">
                <h3 class="fw-semibold">Reserve a Facility</h3>
            </div>
            <div class="card p-4">
                <table class="table table-bordered table-striped text-center align-middle">
                    <thead>
                        <tr>
                            <th>Facility Name</th>
                            <th>Type</th>
                            <th>Capacity</th>
                            <th>Occupation</th>
                            <th>Status</th>
                            <th>Time Slot</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% facilities.forEach(facility=> { %>
                            <tr>
                                <td>
                                    <%= facility.name %>
                                </td>
                                <td>
                                    <%= facility.type %>
                                </td>
                                <td>
                                    <%= facility.capacity %>
                                </td>
                                <td>
                                    <%= facility.occupation %>
                                </td>
                                <td>
                                    <%= facility.status %>
                                </td>
                                <td>
                                    <form action="/studentReservation" method="POST" style="display:flex; align-items:center; gap:6px;">
                                        <input type="hidden" name="facility_id" value="<%= facility.id %>">
                                        <input type="hidden" name="name" value="<%= facility.name %>">
                                        <input type="hidden" name="type" value="<%= facility.type %>">

                                        <select name="time" class="form-select form-select-sm" required>
                                            <option value="">Select Time Slot</option>
                                            <option value="08:00:00-11:00:00">8:00 AM - 11:00 AM</option>
                                            <option value="13:00:00-15:00:00">1:00 PM - 3:00 PM</option>
                                            <option value="15:00:00-17:00:00">3:00 PM - 5:00 PM</option>
                                        </select>
                                </td>

                                <td>
                                    <button type="submit" class="btn btn-success btn-sm">Reserve</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
                <tfoot>
                    <tr>
                        <td colspan="6">
                            <nav>
                                <ul id="pagination" class="pagination justify-content-center"></ul>
                            </nav>
                        </td>
                    </tr>
                </tfoot>
            </div>
        </section>

        <section id="reservations" class="mb-5">
    <div class="section-header d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-semibold">My Reservations (Today)</h3>
        <a href="/student/reservations" class="btn btn-history">Reservations History</a>
    </div>
    <div class="card p-3">
        <table class="table table-bordered table-striped text-center align-middle">
            <thead>
                <tr>
                    <th>Facility Name</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% let hasBookings = false; %>
                <% if (bookings && bookings.length > 0) { %>
                    <% for(let booking of bookings) { %>
                        <% hasBookings = true; %>
                        <tr>
                            <td><%= booking.name %></td>
                            <td><%= booking.type %></td>
                            <td>
                                <%= (() => {
                                    const d = new Date(booking.date);
                                    const yyyy = d.getFullYear();
                                    const mm = String(d.getMonth() + 1).padStart(2, '0');
                                    const dd = String(d.getDate()).padStart(2, '0');
                                    return `${yyyy}-${mm}-${dd}`;
                                })() %>
                            </td>
                            <td>
                                <%= new Date('1970-01-01T' + booking.start_time).toLocaleTimeString('en-US', { 
                                    hour: 'numeric', 
                                    minute: '2-digit', 
                                    hour12: true 
                                }) %> - 
                                <%= new Date('1970-01-01T' + booking.end_time).toLocaleTimeString('en-US', { 
                                    hour: 'numeric', 
                                    minute: '2-digit', 
                                    hour12: true 
                                }) %>
                            </td>
                            <td>
                                <span class="badge bg-success">Approved</span>
                            </td>
                            <td>
                                N/A
                            </td>
                        </tr>
                    <% } %>
                <% } %>
                
                <% if (!hasBookings) { %>
                    <tr>
                        <td colspan="6" class="text-muted py-4">
                            <div class="d-flex flex-column align-items-center">
                                <span>No reservations found.</span>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

        <section id="feedback" class="mb-5">
            <div class="section-header d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-semibold">Submit Feedback</h3>
                <a href="/student/feedbacks" class="btn btn-history">Feedback History</a>
            </div>
            <div class="card p-4">
                <form action="/student/addFeedback" method="POST">
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rate Your Experience</label>
                        <select id="rating" name="rating" class="form-select" required>
                            <option value="" disabled selected>Select rating</option>
                            <option value="5">5 Stars</option>
                            <option value="4">4 Stars</option>
                            <option value="3">3 Stars</option>
                            <option value="2">2 Stars</option>
                            <option value="1">1 Star</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="service" class="form-label">Service Quality</label>
                        <select id="service" name="service_quality" class="form-select" required>
                            <option value="" disabled selected>Select service quality</option>
                            <option value="Excellent">Excellent</option>
                            <option value="Good">Good</option>
                            <option value="Average">Average</option>
                            <option value="Poor">Poor</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="cleanliness" class="form-label">Facility Cleanliness</label>
                        <select id="cleanliness" name="facility_cleanliness" class="form-select" required>
                            <option value="" disabled selected>Select cleanliness level</option>
                            <option value="Excellent">Excellent</option>
                            <option value="Good">Good</option>
                            <option value="Average">Average</option>
                            <option value="Poor">Poor</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="comments" class="form-label">Comments</label>
                        <textarea id="comments" name="comments" class="form-control" rows="3"
                            placeholder="Write your feedback..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="suggestions" class="form-label">Suggestions for Improvement</label>
                        <textarea id="suggestions" name="suggestions" class="form-control" rows="2"
                            placeholder="Your suggestions..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-green">Submit Feedback</button>
                </form>
            </div>
        </section>


    </div>

    <footer>
        © 2025 FacilityFlow | PHINMA University of Iloilo
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/student_db.js"></script>
    <script src="/js/student_dbscript.js"></script>

    <% if (alert) { %>
        <script>
            Swal.fire({
                icon: '<%= alert.type %>',
                title: '<%= alert.title %>',
                text: '<%= alert.message %>',
                timer: 1500,
                showConfirmButton: false
            });
        </script>
        <% } %>

            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
                document.getElementById("logoutBtn").addEventListener("click", function () {
                    Swal.fire({
                        title: "Are you sure you want to log out?",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#2e8b57",
                        cancelButtonColor: "#aaa",
                        confirmButtonText: "Yes, log out"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = "/logout";
                        }
                    });
                });

                document.addEventListener("DOMContentLoaded", function () {
                    const dateInput = document.getElementById("date");
                    const today = new Date().toISOString().split("T")[0];
                    dateInput.value = today;
                    dateInput.min = today;
                });
            </script>

    <script type="module">
        import { initFacilityPagination } from '/js/facilityPagination.js';
        const facilitiesData = <%- JSON.stringify(facilities.filter(f => ['Laboratory','Study Room','Library'].includes(f.type))) %>;
        initFacilityPagination(facilitiesData);
    </script>
    
</body>

</html>