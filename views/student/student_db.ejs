<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FacilityFlow | Student Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/student/student_db.css" />
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="dashboard.html">
                <img src="/images/logaur.png" alt="FacilityFlow Logo">
                FacilityFlow
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav d-flex align-items-center gap-3">
                    <li class="nav-item"><a class="nav-link" href="#dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="#booking">Book a Facility</a></li>
                    <li class="nav-item"><a class="nav-link" href="#reservations">My Reservations</a></li>
                    <li class="nav-item"><a class="nav-link" href="#feedback">Feedback</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container container-main my-5">
        <section id="profile" class="mb-5">
            <div
                class="card profile-card p-4 d-flex flex-md-row flex-column align-items-center justify-content-between shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-md-0 mb-3">
                    <img src="/images/default-profile.png" alt="Profile Picture" class="profile-pic rounded-circle">
                    <div>
                        <h5 class="mb-0 fw-semibold">
                            <%= user.name %>
                        </h5>
                        <p class="text-muted mb-0">
                            <%= user.role %>, BS Information Technology
                        </p>
                    </div>
                </div>
                <button class="btn btn-logout" id="logoutBtn">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </div>
        </section>


        <!-- DASHBOARD -->
        <section id="dashboard" class="mb-5">
            <h3 class="mb-4 fw-semibold">Facility Dashboard</h3>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card p-4">
                        <h5 class="fw-semibold mb-3">Labs</h5>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar progress-bar-almost" style="width:70%"></div>
                        </div>
                        <p>Status: <strong style="color: #f0ad4e;">Almost Full</strong></p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-4">
                        <h5 class="fw-semibold mb-3">Library</h5>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar progress-bar-full" style="width: 90%"></div>
                        </div>
                        <p>Status: <strong style="color: #d9534f;">Full</strong></p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-4">
                        <h5 class="fw-semibold mb-3">Study Rooms</h5>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar progress-bar-available" style="width: 40%"></div>
                        </div>
                        <p>Status: <strong style="color: #5cb85c;">Available</strong></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- BOOKING -->
        <section id="booking" class="mb-5">
            <div class="section-header">
                <h3 class="fw-semibold">Reserve a Facility</h3>
            </div>
            <div class="card p-4">
                <form id="bookingForm" action="/studentReservation" method="POST">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Facility</label>
                            <select class="form-select" id="facility" name="type">
                                <option>Labs</option>
                                <option>Library</option>
                                <option>Study Room</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Date</label>
                            <input type="date" class="form-control" id="date" name="date" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Time Slot</label>
                            <select class="form-select" id="timeSlot" name="time">
                                <option value="8:00 AM - 10:00 AM">8:00 AM - 10:00 AM</option>
                                <option value="10:00 AM - 12:00 NN">10:00 AM - 12:00 NN</option>
                                <option value="1:00 PM - 3:00 PM">1:00 PM - 3:00 PM</option>
                                <option value="3:00 PM - 5:00 PM">3:00 PM - 5:00 PM</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-green w-100">Reserve</button>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        <!-- RESERVATION HISTORY -->
        <section id="reservations" class="mb-5">
            <div class="section-header d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-semibold">My Reservations (Active)</h3>
                <a href="/student/reservations" class="btn btn-history">Reservations History</a>
            </div>
            <div class="card p-3">
                <table class="table table-bordered table-striped text-center align-middle">
                    <thead>
                        <tr>
                            <th>Facility</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="bookingList">
                        <% bookings.forEach(function(booking) { %>
                            <% if (booking.status==='Pending' || booking.status==='Approved' ) { %>
                                <tr>
                                    <td>
                                        <%= booking.type %>
                                    </td>
                                    <td>
                                        <%= booking.date.toISOString().split('T')[0] %>
                                    </td>
                                    <td>
                                        <%= booking.time %>
                                    </td>
                                    <td>
                                        <% if (booking.status==='Pending' ) { %>
                                            <span class="badge bg-warning text-dark">
                                                <%= booking.status %>
                                            </span>
                                            <% } else if (booking.status==='Approved' ) { %>
                                                <span class="badge bg-success">
                                                    <%= booking.status %>
                                                </span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <% if (booking.status==='Pending' ) { %>
                                            <form action="/cancelReservation" method="POST"
                                                onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                                                <input type="hidden" name="reservation_id" value="<%= booking.id %>">
                                                <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                            </form>
                                            <% } else { %>
                                                N/A
                                                <% } %>
                                    </td>
                                </tr>
                                <% } %>
                                    <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <section id="feedback" class="mb-5">
            <div class="section-header d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-semibold">Submit Feedback</h3>
                <a href="/student/feedbacks" class="btn btn-history">Feedback History</a>
            </div>
            <div class="card p-4">
                <form action="/student/addFeedback" method="POST">
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rate Your Experience</label>
                        <select id="rating" name="rating" class="form-select" required>
                            <option value="" disabled selected>Select rating</option>
                            <option value="5">5 Stars</option>
                            <option value="4">4 Stars</option>
                            <option value="3">3 Stars</option>
                            <option value="2">2 Stars</option>
                            <option value="1">1 Star</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="service" class="form-label">Service Quality</label>
                        <select id="service" name="service_quality" class="form-select" required>
                            <option value="" disabled selected>Select service quality</option>
                            <option value="Excellent">Excellent</option>
                            <option value="Good">Good</option>
                            <option value="Average">Average</option>
                            <option value="Poor">Poor</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="cleanliness" class="form-label">Facility Cleanliness</label>
                        <select id="cleanliness" name="facility_cleanliness" class="form-select" required>
                            <option value="" disabled selected>Select cleanliness level</option>
                            <option value="Excellent">Excellent</option>
                            <option value="Good">Good</option>
                            <option value="Average">Average</option>
                            <option value="Poor">Poor</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="comments" class="form-label">Comments</label>
                        <textarea id="comments" name="comments" class="form-control" rows="3"
                            placeholder="Write your feedback..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="suggestions" class="form-label">Suggestions for Improvement</label>
                        <textarea id="suggestions" name="suggestions" class="form-control" rows="2"
                            placeholder="Your suggestions..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-green">Submit Feedback</button>
                </form>
            </div>
        </section>


    </div>

    <footer>
        © 2025 FacilityFlow | PHINMA University of Iloilo
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <% if (alert) { %>
        <script>
            Swal.fire({
                icon: '<%= alert.type %>',
                title: '<%= alert.title %>',
                text: '<%= alert.message %>',
                timer: 1500,
                showConfirmButton: false
            });
        </script>
        <% } %>

            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
                document.getElementById("logoutBtn").addEventListener("click", function () {
                    Swal.fire({
                        title: "Are you sure you want to log out?",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#2e8b57",
                        cancelButtonColor: "#aaa",
                        confirmButtonText: "Yes, log out"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = "/logout";
                        }
                    });
                });

                document.addEventListener("DOMContentLoaded", function () {
                    const dateInput = document.getElementById("date");
                    const today = new Date().toISOString().split("T")[0];
                    dateInput.value = today;
                    dateInput.min = today;
                });
            </script>
</body>

</html>